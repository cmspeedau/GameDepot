# Copy to .env and edit. Never commit the result.

# PostgreSQL connection string. Required.
DATABASE_URL=postgresql://gamedepot:gamedepot@localhost:5432/gamedepot

# Public origin of this instance. Used for depot URLs, pairing links and
# Secure cookies. No trailing slash.
EXTERNAL_URL=http://localhost:4000

# HTTP listen port.
PORT=4000

# Library volume: game files and version directories.
LIBRARY=./.data/library

# Data volume: objects, depot chunks, manifests and the certificate authority.
DATA=./.data/data

# Apply goose migrations on boot. Defaults to true in development.
# GAMEDEPOT_AUTO_MIGRATE=true

# Scheduled maintenance intervals (Go durations). Zero disables a job.
# Integrity re-verifies every release manifest against the depot; cleanup removes
# expired pairing codes and sessions. Defaults: 24h and 1h.
# GAMEDEPOT_INTEGRITY_INTERVAL=24h
# GAMEDEPOT_CLEANUP_INTERVAL=1h

# 32 byte key (openssl rand -hex 32) that seals stored store credentials.
# Required before connecting GOG, Epic, Ubisoft or EA. Rotating it orphans
# existing sealed rows.
# GAMEDEPOT_CREDENTIAL_KEY=

# Enable store ingestion surfaces. Defaults to off.
GAMEDEPOT_STORE=false

# Metadata provider timeout in milliseconds.
METADATA_TIMEOUT=5000

# Update check. Defaults to true when running a production build.
# CHECK_FOR_UPDATES=false

# debug, info, warn, error
LOG_LEVEL=info
